{
  "name": "taskflow-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:setup": "prisma migrate deploy && prisma generate && npm run db:seed",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:large": "ts-node --transpile-only prisma/seed-large.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src --ext .ts",
    "test:pact": "jest --runInBand --passWithNoTests --config jest.pact.config.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@pact-foundation/pact": "16.5.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.19.9",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  }
}
